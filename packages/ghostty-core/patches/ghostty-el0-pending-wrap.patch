+/// Reset the cursor row's soft-wrap state without clearing the cursor's
+/// pending wrap. Erase-in-line keeps the pending wrap flag so a row filled
+/// to the right margin still wraps on the next printed character.
+pub fn cursorResetRowWrap(self: *Screen) void {
     const page_row = self.cursor.page_row;
 
     if (!page_row.wrap) return;
